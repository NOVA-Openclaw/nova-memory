+        echo "  ✓ Opinion reinforced: $actual_holder on $subject (vote_count++)"
     fi
     
     cols="entity_id, key, value, source, visibility"
@@ -230,8 +255,8 @@ echo "$JSON_DATA" | jq -c '.preferences[]? // empty' | while read -r pref; do
     
